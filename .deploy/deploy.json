{
  "projectName": "test-pro",
  "host": "test-pro.app.vayi.cn",
  "jobs": [
    {
      "name": "migrate",
      "image": "test-pro",
      "command": ["python", "-c"],
      "args": [
        "import sqlite3; connection = sqlite3.connect(':memory:'); connection.execute('SELECT 1'); print('migration check: SELECT 1 OK'); connection.close()"
      ],
      "backoffLimit": 1,
      "ttlSecondsAfterFinished": 300
    }
  ],
  "services": [
    {
      "name": "app",
      "context": ".",
      "dockerfile": "Dockerfile",
      "image": "test-pro",
      "containerPort": 8000,
      "servicePort": 8000,
      "path": "/",
      "expose": true,
      "envFrom": [
        {
          "secretRef": {
            "name": "test-pro-app-runtime"
          }
        }
      ]
    }
  ]
}
