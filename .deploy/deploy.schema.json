{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectName", "host", "runtimeSecretName", "prRuntimeSecretSourceName", "services"],
  "properties": {
    "projectName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
    "host": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?\\.app\\.vayi\\.cn$" },
    "runtimeSecretName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
    "prRuntimeSecretSourceName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
    "services": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/service" } },
    "jobs": { "type": "array", "items": { "$ref": "#/$defs/job" } }
  },
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "context", "dockerfile", "image", "containerPort", "servicePort", "expose"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "context": { "type": "string", "minLength": 1 },
        "dockerfile": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "servicePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "path": { "type": "string", "pattern": "^/" },
        "expose": { "type": "boolean" },
        "env": { "type": "array" },
        "envFrom": { "type": "array" },
        "resources": { "type": "object" },
        "replicas": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        { "if": { "properties": { "expose": { "const": true } } }, "then": { "required": ["path"] } }
      ]
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "image"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "image": { "type": "string", "minLength": 1 },
        "command": { "type": "array", "items": { "type": "string" } },
        "args": { "type": "array", "items": { "type": "string" } },
        "env": { "type": "array" },
        "envFrom": { "type": "array" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
